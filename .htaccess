# ========================================================================
# Root Apache / LiteSpeed Configuration: Jarvis Monitor
# Melindungi file backend root dan mengarahkan traffic ke /public
# ========================================================================

Options -Indexes -MultiViews

# Blokir akses langsung ke file konfigurasi backend dan file sensitif
<FilesMatch "^(config\.php|sync_github\.php|schema\.sql|\.env.*|\.git.*|.*\.zip)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fallback: jika Document Root server belum diatur langsung ke /public, forward ke /public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
