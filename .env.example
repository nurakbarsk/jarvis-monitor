PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opsional
# GITHUB_WEBHOOK_SECRET=      # verifikasi X-Hub-Signature-256 dari GitHub
# NODE_ENV=production         # DB otomatis di /data/monitor.db (persistent volume)
# DB_PATH=/data/monitor.db    # override path database
# SEED_DEMO=false             # data contoh (default: aktif di development saja)
# TZ_OFFSET_MINUTES=420       # zona waktu grafik aktivitas (default WIB)
