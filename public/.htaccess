# ========================================================================
# Apache / LiteSpeed Configuration: Jarvis Monitor (Public Document Root)
# ========================================================================

Options -Indexes -MultiViews

# Lindungi file tersembunyi dan ekstensi sensitif
<FilesMatch "^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Pengaturan batas ukuran upload (LiteSpeed / Apache PHP Handler)
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
    php_value memory_limit 128M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
    php_value memory_limit 128M
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Rute bersih untuk portal kendala klien: /portal -> portal.php
    RewriteRule ^portal/?$ portal.php [QSA,L]

    # Rute bersih untuk endpoint API: /api/... -> api.php?route=...
    RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]
    RewriteRule ^api/?$ api.php [QSA,L]

    # Rute bersih untuk sync github jika dipanggil /sync_github
    RewriteRule ^sync_github/?$ sync_github.php [QSA,L]
</IfModule>
